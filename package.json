{
  "name": "sillytavern-vellum",
  "private": true,
  "version": "0.2.5",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc --noEmit && pnpm build:server && pnpm build:electron",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "gate:boundaries": "tsx scripts/gate-boundaries.ts",
    "gate:no-hex": "tsx scripts/gate-no-hex.ts",
    "gate:file-size": "tsx scripts/gate-file-size.ts",
    "gate:screens": "tsx scripts/gate-screens-vs-routes.ts",
    "gate:ownership": "tsx scripts/gate-ownership.ts",
    "verify": "pnpm build && pnpm test && pnpm lint && pnpm gate:selftest && pnpm gate:boundaries && pnpm gate:no-hex && pnpm gate:file-size && pnpm gate:screens && pnpm gate:back && pnpm gate:no-eval && pnpm gate:draft && pnpm gate:guides && pnpm gate:toast && pnpm gate:no-docker && pnpm gate:preamble && pnpm gate:licenses && pnpm gate:ownership",
    "gate:selftest": "for f in scripts/gate-*.ts; do pnpm exec tsx \"$f\" --selftest || exit 1; done",
    "dev:server": "PORT=18521 tsx watch server/index.ts",
    "server": "PORT=18521 tsx server/index.ts",
    "gate:back": "tsx scripts/gate-back.ts",
    "start": "cross-env NODE_ENV=production node dist-server/index.mjs",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist-server/index.mjs",
    "verify:card": "tsx scripts/verify-card-roundtrip.ts",
    "verify:chat": "tsx scripts/verify-chat-roundtrip.ts",
    "verify:card:e2e": "tsx scripts/verify-card-e2e.ts",
    "verify:wi": "tsx scripts/verify-worldbook.ts",
    "verify:rules": "tsx scripts/verify-output-rules.ts",
    "verify:vars": "tsx scripts/verify-vars.ts",
    "gate:no-eval": "tsx scripts/gate-no-eval.ts",
    "gate:draft": "tsx scripts/gate-draft.ts",
    "gate:guides": "tsx scripts/gate-provider-guides.ts",
    "gate:toast": "tsx scripts/gate-toast.ts",
    "verify:companion": "tsx scripts/verify-companion.ts",
    "verify:lifecycle": "tsx scripts/verify-lifecycle.ts",
    "verify:swipe": "tsx scripts/verify-swipe.ts",
    "start:fresh": "pnpm build && pnpm start",
    "package": "tsx scripts/package-zip.ts",
    "gate:no-docker": "tsx scripts/gate-no-docker.ts",
    "app:dev": "pnpm build && electron .",
    "app:build": "pnpm build && electron-builder --config electron-builder.yml --publish never && tsx scripts/gate-signer.ts && node scripts/rename-mac-intel-zip.cjs",
    "gate:signer": "tsx scripts/gate-signer.ts",
    "build:electron": "esbuild electron/updater.cjs --bundle --platform=node --format=cjs --target=node20 --external:electron --outfile=electron/updater.bundle.cjs",
    "gate:preamble": "tsx scripts/gate-preamble.ts",
    "notices": "tsx scripts/notices.ts",
    "gate:licenses": "tsx scripts/notices.ts --check",
    "setup:worktree": "pnpm install && pnpm exec tsx scripts/setup-worktree.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hono/node-server": "^2.1.1",
    "@hookform/resolvers": "^5.9.1",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@tanstack/react-query": "^5.102.3",
    "@tanstack/react-router": "^1.170.32",
    "@xstate/react": "^6.1.0",
    "dompurify": "^3.4.14",
    "electron-updater": "^6.8.9",
    "hono": "^4.13.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "showdown": "^2.1.0",
    "xstate": "^5.32.5",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@playwright/test": "^1.62.1",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/router-plugin": "^1.168.35",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/showdown": "^2.0.6",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "cross-env": "^10.1.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "0.28.2",
    "jquery": "3.7.1",
    "js-yaml": "4.3.1",
    "jsdom": "^30.0.1",
    "lodash": "4.18.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron",
      "electron-winstaller"
    ],
    "overrides": {
      "lodash": "4.18.1"
    }
  },
  "main": "electron/main.cjs"
}
