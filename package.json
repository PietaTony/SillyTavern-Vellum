{
  "name": "sillytavern-vellum",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "gate:boundaries": "node scripts/gate-boundaries.mjs",
    "gate:no-hex": "node scripts/gate-no-hex.mjs",
    "gate:file-size": "node scripts/gate-file-size.mjs",
    "gate:screens": "node scripts/gate-screens-vs-routes.mjs",
    "verify": "pnpm typecheck && pnpm test && pnpm lint && pnpm gate:selftest && pnpm gate:boundaries && pnpm gate:no-hex && pnpm gate:file-size && pnpm gate:screens && pnpm gate:back",
    "gate:selftest": "for f in scripts/gate-*.mjs; do node \"$f\" --selftest || exit 1; done",
    "dev:server": "tsx watch server/index.ts",
    "server": "tsx server/index.ts",
    "gate:back": "node scripts/gate-back.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.102.3",
    "@tanstack/react-router": "^1.170.32",
    "@xstate/react": "^6.1.0",
    "hono": "^4.13.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "xstate": "^5.32.5",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@playwright/test": "^1.62.1",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/router-plugin": "^1.168.35",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
