{
  "_readme": "GAP-124 狀態判準正本。每個 catalog id 一列；stateRule 供 feature owner 實作與 dispatch 對帳。規範：design/GAP-124-spec.md",
  "protocolVersion": "0",
  "active": "M2",
  "fallbackPolicy": "同一 route 無法判定時用該 route 第一個 id（screens.json 順序）",
  "bindings": [
    {
      "id": "First-Run--1",
      "route": "first-run/provider",
      "owner": "providers",
      "implemented": false,
      "stateRule": "route === first-run/provider"
    },
    {
      "id": "First-Run--3",
      "route": "first-run/key",
      "owner": "providers",
      "implemented": false,
      "fallbackId": "First-Run--3",
      "stateRule": "有 search.id；key 欄 !dirty；!keySet；欄位為空或未貼上"
    },
    {
      "id": "First-Run--3a",
      "route": "first-run/key",
      "owner": "providers",
      "implemented": false,
      "stateRule": "有 search.id；KeyField dirty===true；尚未發生本 session 成功存 key"
    },
    {
      "id": "First-Run--3b",
      "route": "first-run/key",
      "owner": "providers",
      "implemented": false,
      "stateRule": "有 search.id；dirty；最近一次 testAndSaveKey/testStoredKey 回 ok===false（Phase 1 需 H5 暴露 lastKeyTestFailed 或等價信號）"
    },
    {
      "id": "First-Run--3c",
      "route": "first-run/key",
      "owner": "providers",
      "implemented": false,
      "stateRule": "有 search.id；row.keySet===true；KeyField !dirty；footer 下一步可點"
    },
    {
      "id": "First-Run--4",
      "route": "first-run/add-friend",
      "owner": "characters",
      "implemented": false,
      "fallbackId": "First-Run--4",
      "stateRule": "首次流程加入好友；表單空白；無卡庫 dropdown"
    },
    {
      "id": "First-Run--6",
      "route": "first-run/add-friend",
      "owner": "characters",
      "implemented": false,
      "stateRule": "首次流程加入好友；卡庫 ExistingCardPicker dropdown 展開"
    },
    {
      "id": "First-Run--7",
      "route": "first-run/add-friend",
      "owner": "characters",
      "implemented": false,
      "stateRule": "首次流程加入好友；必填欄已填"
    },
    {
      "id": "First-Run--4b",
      "route": "add-friend",
      "owner": "characters",
      "implemented": false,
      "stateRule": "設定完成後入口；版面同 First-Run--4；back 落點 chat-list"
    },
    {
      "id": "Tab-Friends--undrawn",
      "route": "friends",
      "owner": "characters",
      "implemented": false,
      "stateRule": "friends tab 根；無 onBack"
    },
    {
      "id": "Friends-And-Cards--1",
      "route": "chat-list",
      "owner": "chat-core",
      "implemented": false,
      "stateRule": "chat-list tab 根；標題「聊天」"
    },
    {
      "id": "Chat-Thread-Layout--5",
      "route": "chat/$chatId",
      "owner": "chat-core",
      "implemented": false,
      "fallbackId": "Chat-Thread-Layout--5",
      "stateRule": "對話串；!busy && !thinking（一般閒置／捲動）"
    },
    {
      "id": "Waiting-And-Thinking--1",
      "route": "chat/$chatId",
      "owner": "chat-core",
      "implemented": false,
      "stateRule": "對話串；生成中 busy 或 thinking 指示可見"
    },
    {
      "id": "Tab-Settings--undrawn",
      "route": "settings",
      "owner": "platform",
      "implemented": false,
      "stateRule": "settings tab 根"
    },
    {
      "id": "Settings-About--undrawn",
      "route": "settings/about",
      "owner": "platform",
      "implemented": false,
      "stateRule": "settings/about 關於與更新"
    },
    {
      "id": "Settings-Network--undrawn",
      "route": "settings/network",
      "owner": "platform",
      "implemented": false,
      "stateRule": "settings/network 其他裝置：允許連線開關 + 存取密碼"
    },
    {
      "id": "Login--1",
      "route": "login",
      "owner": "platform",
      "implemented": false,
      "stateRule": "route === login；只有設了存取密碼且未登入時 root 守衛才會導來"
    },
    {
      "id": "Layer-Chat-Menu--1",
      "kind": "menu",
      "hostRoute": "chat/$chatId",
      "owner": "chat-core",
      "implemented": false,
      "stateRule": "chat/$chatId；ChatMenu anchor 非 null；其上無 open 的 FullScreenLayer／Dialog"
    },
    {
      "id": "Layer-Persona--1",
      "kind": "layer",
      "hostRoute": "chat/$chatId",
      "owner": "characters",
      "implemented": false,
      "stateRule": "PersonaLayer open===true（且無更高優先 dialog）"
    },
    {
      "id": "Layer-Backgrounds-Chat--1",
      "kind": "layer",
      "hostRoute": "chat/$chatId",
      "owner": "platform",
      "implemented": false,
      "stateRule": "BackgroundsLayer scope=chat open===true"
    },
    {
      "id": "Layer-Providers-List--1",
      "kind": "layer",
      "hostRoute": "chat/$chatId",
      "owner": "providers",
      "implemented": false,
      "stateRule": "ProvidersLayer open && openId===null"
    },
    {
      "id": "Layer-Providers-Detail--1",
      "kind": "layer",
      "hostRoute": "chat/$chatId",
      "owner": "providers",
      "implemented": false,
      "stateRule": "ProvidersLayer open && openId!==null"
    },
    {
      "id": "Layer-Greetings--1",
      "kind": "layer",
      "hostRoute": "chat/$chatId",
      "owner": "characters",
      "implemented": false,
      "stateRule": "GreetingsLayer open && confirming===null"
    },
    {
      "id": "Dialog-Greetings-Delete--1",
      "kind": "dialog",
      "hostRoute": "chat/$chatId",
      "owner": "characters",
      "implemented": false,
      "stateRule": "GreetingsLayer 內 confirming!==null"
    },
    {
      "id": "Layer-Character--1",
      "kind": "layer",
      "hostRoute": "chat/$chatId",
      "owner": "characters",
      "implemented": false,
      "stateRule": "CharacterLayer open && !WorldSection open && !WorldEntryLayer open"
    },
    {
      "id": "Layer-World-Book--1",
      "kind": "layer",
      "hostRoute": "chat/$chatId",
      "owner": "worldbook",
      "implemented": false,
      "stateRule": "WorldSection open && !WorldEntryLayer open"
    },
    {
      "id": "Layer-World-Entry--1",
      "kind": "layer",
      "hostRoute": "chat/$chatId",
      "owner": "worldbook",
      "implemented": false,
      "stateRule": "WorldEntryLayer open===true"
    },
    {
      "id": "Layer-Message-Actions--1",
      "kind": "menu",
      "hostRoute": "chat/$chatId",
      "owner": "chat-core",
      "implemented": false,
      "stateRule": "MessageRow 長按／右鍵選單 open；無更高優先 dialog"
    },
    {
      "id": "Layer-Message-Edit--1",
      "kind": "layer",
      "hostRoute": "chat/$chatId",
      "owner": "chat-core",
      "implemented": false,
      "stateRule": "MessageEditor 編輯模式 open===true"
    },
    {
      "id": "Dialog-Confirm-Delete--1",
      "kind": "dialog",
      "hostRoute": "chat/$chatId",
      "owner": "chat-core",
      "implemented": false,
      "stateRule": "刪除訊息確認 Dialog open"
    },
    {
      "id": "Dialog-Confirm-Regenerate--1",
      "kind": "dialog",
      "hostRoute": "chat/$chatId",
      "owner": "chat-core",
      "implemented": false,
      "stateRule": "重新生成確認 Dialog open"
    },
    {
      "id": "Layer-Swipe-Picker--1",
      "kind": "layer",
      "hostRoute": "chat/$chatId",
      "owner": "chat-core",
      "implemented": false,
      "stateRule": "SwipePicker open===true"
    },
    {
      "id": "Dialog-Consent-Scripts--1",
      "kind": "dialog",
      "hostRoute": "chat/$chatId",
      "owner": "card-scripts",
      "implemented": false,
      "stateRule": "ConsentDialog open===true（最高優先之一）"
    },
    {
      "id": "Layer-Backgrounds-Global--1",
      "kind": "layer",
      "hostRoute": "settings",
      "owner": "platform",
      "implemented": false,
      "stateRule": "BackgroundsLayer scope=global open===true"
    },
    {
      "id": "Layer-World-Picker--1",
      "kind": "dialog",
      "hostRoute": "profile",
      "owner": "worldbook",
      "implemented": false,
      "stateRule": "WorldPicker Dialog open===true"
    }
  ],
  "_excluded": "不登記 id：ToastStack、LanWarning、ChatFailure 橫幅 —— 非全頁狀態，截圖時用底下 route／layer。",
  "_stack": "水印優先：dialog > layer（最深 open）> menu > route。見 GAP-124-spec.md §4。"
}
